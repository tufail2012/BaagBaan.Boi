rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------------
    // User Profiles:
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------------
    // Usernames Uniqueness Collection:
    // ------------------------------------------------------------------------
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------------
    // Direct Chats & Messages:
    // ------------------------------------------------------------------------
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null
                    && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read, create: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && (
            // Receiver: can only move status to delivered or read
            (request.auth.uid != resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status in ['delivered', 'read'])
            // Any participant: can hide a message for themselves
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            // Sender: can edit their own message (use the exact field names that editMessage writes)
            || (request.auth.uid == resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited']))
          );
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // Agora 1-to-1 call signaling. Only the caller and the callee can see or change a call.
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId);
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.status == 'ringing';
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.calleeId);
    }

    // ------------------------------------------------------------------------
    // Shared / Legacy Collections
    // ------------------------------------------------------------------------
    match /crop_records/{recordId} {
      allow read, write: if isAuthenticated();
    }
    match /workers/{workerId} {
      allow read, write: if isAuthenticated();
    }
    match /attendance_records/{attendanceId} {
      allow read, write: if isAuthenticated();
    }
    match /advance_payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
