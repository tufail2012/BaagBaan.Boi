    <path
        android:pathData="M 59,38 Q 60.5,35 63,33.8 M 64,36.8 Q 66.5,34.5 69.5,33.5 M 62,37.5 Q 64.5,41 68,42.5 M 66,36.2 Q 68.5,39.5 71.5,40.8"
